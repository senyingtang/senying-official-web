---
import { organizationJsonLd, webPageJsonLd } from '@syt/seo';
import { badgeClass } from '@syt/ui';
import ButtonLink from '../components/ButtonLink.astro';
import ContactCTA from '../components/ContactCTA.astro';
import FaqSection from '../components/FaqSection.astro';
import ImageFrame from '../components/ImageFrame.astro';
import PageHero from '../components/PageHero.astro';
import ProductShowcaseGrid from '../components/ProductShowcaseGrid.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { aboutComparison, humanHelp, platformStages, principles, workModes } from '../content/about';
import { aboutFaq } from '../content/faqs';
import { mediaAssets } from '../content/media';
import { ogImages } from '../content/ogImages';
import { products, toShowcaseItem } from '../content/products';
import BaseLayout from '../layouts/BaseLayout.astro';
import { lineOaUrl, portalLoginUrl, siteUrl } from '../lib/site';
import { getBrandRuntime } from '../lib/brand-runtime';

const brand = await getBrandRuntime();
const description = '森映不是單純的接案工作室，而是把常見的建站、SEO 與內容需求整理成產品：可以自助建站，也能客製，並保留人工協助入口。';
const resolveHref = (href: string) => (href === 'line' ? lineOaUrl : href === 'portal' ? portalLoginUrl : href);
const isExternal = (href: string) => /^https?:\/\//.test(href);
const help = humanHelp.map((item) => {
  const href = resolveHref(item.link.href);
  return { ...item, href, external: isExternal(href) };
});
---

<BaseLayout
  seo={{ title: '關於森映｜把建站與 SEO 內容需求做成產品', description, path: '/about' }}
  breadcrumbs={[
    { label: '首頁', href: '/' },
    { label: '關於森映', href: '/about' },
  ]}
  faq={aboutFaq}
  jsonLd={[webPageJsonLd(siteUrl, { type: 'AboutPage', name: '關於森映', description, path: '/about' }, brand.seo), organizationJsonLd(siteUrl, brand.seo)]}
  ogImage={ogImages.about}
>
  <PageHero
    eyebrow="關於森映"
    title="森映把常見的建站與內容需求，整理成可以直接使用的產品"
    lead="做過很多網站之後發現，多數品牌的需求其實很接近：清楚的介紹、能自己更新的內容、完整的 SEO 設定。我們把這些做成產品，需要特殊流程時再客製。"
    pills={['產品化', '可自助', '可客製', '保留人工協助']}
  >
    <ButtonLink href="/products" size="lg" cta="primary" fullWidthOnMobile>查看產品方案</ButtonLink>
    <ButtonLink href="/contact" variant="ghost" size="lg" cta="secondary" fullWidthOnMobile class="border border-white/30 text-white hover:bg-white/10">預約討論</ButtonLink>
    <Fragment slot="visual">
      <ImageFrame image={mediaAssets.backgroundBright} loading="eager" fetchpriority="high" aspect="video" caption="森映品牌延伸視覺。" />
    </Fragment>
  </PageHero>

  <Section tone="white" name="not-agency" labelledby="not-agency-heading">
    <SectionHeading
      id="not-agency-heading"
      eyebrow="不是單純接案"
      title="做完一個網站就結束，很難持續累積"
      description="森映不是單純的接案工作室。我們把反覆出現的需求整理成產品，讓網站上線後還能繼續經營。"
    />
    <div class="grid gap-5 md:grid-cols-2">
      <div class="min-w-0 rounded-card border border-border-gray bg-mist-white p-5 sm:p-6">
        <h3 class="text-lg font-bold text-ink">{aboutComparison.agency.title}</h3>
        <ul class="mt-4 grid gap-3">
          {
            aboutComparison.agency.items.map((item) => (
              <li class="flex min-w-0 gap-2 text-sm leading-relaxed text-slate-gray sm:text-base">
                <span class="shrink-0 text-slate-400" aria-hidden="true">
                  ✕
                </span>
                <span class="min-w-0">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="min-w-0 rounded-card border border-teal/50 bg-teal-soft p-5 sm:p-6">
        <h3 class="text-lg font-bold text-ink">{aboutComparison.ours.title}</h3>
        <ul class="mt-4 grid gap-3">
          {
            aboutComparison.ours.items.map((item) => (
              <li class="flex min-w-0 gap-2 text-sm leading-relaxed text-ink sm:text-base">
                <span class="shrink-0 text-teal-strong" aria-hidden="true">
                  ✓
                </span>
                <span class="min-w-0">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <Section name="productized" labelledby="productized-heading">
    <SectionHeading id="productized-heading" eyebrow="產品化" title="把反覆出現的需求，做成固定的產品" description="每個產品都有明確的內容、流程與開通方式，不必每次從零開始談。" />
    <ProductShowcaseGrid items={products.map(toShowcaseItem)} />
  </Section>

  <Section tone="white" name="work-modes" labelledby="work-modes-heading">
    <SectionHeading id="work-modes-heading" eyebrow="可自助，也可客製" title="依需求選擇合作方式" />
    <div class="grid gap-5 lg:grid-cols-2">
      {
        workModes.map((mode, index) => (
          <article class="syt-hover-glow flex h-full min-w-0 flex-col rounded-card border border-border-gray bg-surface p-6 shadow-card sm:p-8">
            <span class={`${badgeClass('teal')} self-start`}>{mode.tag}</span>
            <h3 class="mt-3 text-xl font-bold text-ink sm:text-2xl">{mode.title}</h3>
            <p class="mt-2 leading-relaxed text-slate-gray">{mode.description}</p>
            <ul class="mt-5 grid flex-1 content-start gap-2">
              {mode.points.map((point) => (
                <li class="flex min-w-0 gap-2 text-sm text-ink sm:text-base">
                  <span class="text-teal-strong" aria-hidden="true">
                    ✓
                  </span>
                  <span class="min-w-0">{point}</span>
                </li>
              ))}
            </ul>
            <div class="mt-6">
              <ButtonLink href={mode.cta.href} variant={index === 0 ? 'primary' : 'secondary'} fullWidthOnMobile>
                {mode.cta.label}
              </ButtonLink>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <Section name="human-help" labelledby="human-help-heading">
    <SectionHeading id="human-help-heading" eyebrow="人工協助" title="自助之外，仍然找得到人" description="平台可以自己操作，但卡住的時候不必自己摸索。" />
    <ul class="grid gap-4 md:grid-cols-3">
      {
        help.map((item) => (
          <li class="min-w-0">
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              class="syt-hover-glow flex h-full min-w-0 flex-col rounded-card border border-border-gray bg-surface p-5 shadow-card sm:p-6"
            >
              <span class="text-lg font-bold text-ink">{item.title}</span>
              <span class="mt-2 flex-1 text-sm leading-relaxed text-slate-gray">{item.description}</span>
              <span class="mt-4 text-sm font-semibold text-teal-strong">{item.link.label} →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section tone="white" name="principles" labelledby="principles-heading">
    <SectionHeading id="principles-heading" eyebrow="做事方式" title="我們怎麼做網站" />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        principles.map((item, index) => (
          <div class="min-w-0 rounded-card border border-border-gray bg-surface p-5 shadow-card sm:p-6">
            <span class="font-mono text-xs font-semibold text-teal-strong">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="mt-2 text-lg font-bold text-ink">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-gray">{item.description}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section tone="deep" name="stages" labelledby="stages-heading">
    <SectionHeading id="stages-heading" eyebrow="平台進度" title="平台依版本逐步開放" description="以下是規劃中的開放順序，實際時程會依開發與測試進度調整。" tone="dark" />
    <ol class="grid gap-4 md:grid-cols-3">
      {
        platformStages.map((stage) => (
          <li class="min-w-0 rounded-card border border-white/10 bg-white/5 p-5 sm:p-6">
            <div class="flex items-center gap-3">
              <span class="rounded-lg bg-teal px-2.5 py-1 font-mono text-sm font-bold text-navy-black">{stage.stage}</span>
              <h3 class="text-lg font-bold text-white">{stage.title}</h3>
            </div>
            <ul class="mt-4 grid gap-2 text-sm text-slate-300">
              {stage.items.map((item) => (
                <li class="flex min-w-0 gap-2">
                  <span class="text-teal" aria-hidden="true">
                    •
                  </span>
                  <span class="min-w-0">{item}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </Section>

  <FaqSection items={aboutFaq} tone="mist" />
  <ContactCTA title="和森映聊聊你的想法" description="先說明目標與目前的狀況，我們會一起整理下一步，決定自助建站或客製。" />
</BaseLayout>
