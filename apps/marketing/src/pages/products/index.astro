---
import { itemListJsonLd } from '@syt/seo';
import ButtonLink from '../../components/ButtonLink.astro';
import CategoryChips from '../../components/CategoryChips.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import Container from '../../components/Container.astro';
import FaqSection from '../../components/FaqSection.astro';
import FinalCTA from '../../components/FinalCTA.astro';
import IconGlyph from '../../components/IconGlyph.astro';
import MockupAlignedHero from '../../components/MockupAlignedHero.astro';
import ProcessTimeline from '../../components/ProcessTimeline.astro';
import ProductHeroVisual from '../../components/ProductHeroVisual.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import Section from '../../components/Section.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { productsFaq } from '../../content/faqs';
import { mediaAssets } from '../../content/media';
import { ogImages } from '../../content/ogImages';
import { PRICING_NOTICE } from '../../content/pricing';
import { products } from '../../content/products';
import {
  comparisonColumns,
  comparisonRows,
  overviewProducts,
  productAudiences,
  productFilterChips,
  productsFinalCta,
  productsHero,
  quickStartSteps,
} from '../../content/productsOverview';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { coverSizes } from '../../lib/image-variants';
import { siteUrl } from '../../lib/site';

const breadcrumbs = [
  { label: '首頁', href: '/' },
  { label: '產品服務', href: '/products' },
];
---

<BaseLayout
  seo={{
    title: '產品服務｜SEO 形象官網、一頁式網頁、電商與 SEO 文章工具',
    description: '森映產品總覽：SEO 形象官網、一頁式網頁、電商網站、活動 DM 宣傳頁與 SEO 文章工具，比較適合對象、頁面數量、金流與 SEO 設定，依目的選擇產品。',
    path: '/products',
  }}
  breadcrumbs={breadcrumbs}
  breadcrumbsInHero
  faq={productsFaq}
  jsonLd={[itemListJsonLd(siteUrl, { name: '森映產品目錄', items: products.map((product) => ({ name: product.name, path: product.path })) })]}
  ogImage={ogImages.products}
>
  <MockupAlignedHero eyebrow={productsHero.eyebrow} title={productsHero.title} highlight={productsHero.highlight} lead={productsHero.lead} breadcrumbs={breadcrumbs} script={productsHero.script}>
    <ButtonLink href={productsHero.primary.href} size="lg" cta="primary" fullWidthOnMobile>
      {productsHero.primary.label}
      <span aria-hidden="true">→</span>
    </ButtonLink>
    <ButtonLink href={productsHero.secondary.href} variant="ghost" size="lg" cta="secondary" fullWidthOnMobile class="border border-white/40 text-white hover:bg-white/10">
      <IconGlyph name="play" class="h-5 w-5 text-teal" />
      {productsHero.secondary.label}
    </ButtonLink>
    <Fragment slot="visual">
      <ProductHeroVisual image={mediaAssets.templateShowcase} badges={productsHero.badges} caption="產品畫面示意：同一套版型在不同裝置的呈現。" />
    </Fragment>
  </MockupAlignedHero>

  <!-- 分類篩選 -->
  <section data-section="categories" aria-label="產品分類" class="border-b border-border-gray bg-surface py-4">
    <Container>
      <CategoryChips items={productFilterChips} target="products" label="產品分類">
        <a href="#comparison" class="inline-flex min-h-10 items-center gap-1 text-sm font-semibold text-teal-strong hover:underline">
          比較產品功能
          <span aria-hidden="true">→</span>
        </a>
      </CategoryChips>
    </Container>
  </section>

  <!-- 產品卡片 -->
  <Section density="compact" name="product-cards" labelledby="product-cards-heading">
    <SectionHeading id="product-cards-heading" title="森映數位產品一覽" description="從品牌官網到行銷推廣，選擇最適合的產品，開始你的數位成長旅程。" compact />
    <ul data-filter-list="products" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {
        overviewProducts.map((product) => (
          <li data-filter-item data-filter-tags={product.filterTags.join(' ')} class="min-w-0">
            <article class="syt-hover-glow flex h-full min-w-0 flex-col overflow-hidden rounded-2xl border border-border-gray bg-surface shadow-card transition-colors hover:border-teal/50">
              <div class="aspect-[16/10] overflow-hidden bg-mist-white">
                <ResponsiveImage src={product.image.src} alt={product.image.alt} width={product.image.width} height={product.image.height} loading="lazy" sizes={coverSizes([['(min-width: 1280px)', 20], ['(min-width: 1024px)', 34], ['(min-width: 640px)', 50], [null, 100]], { width: 16, height: 10 }, product.image)} class="h-full w-full" />
              </div>
              <div class="relative flex flex-1 flex-col px-4 pb-4 pt-8">
                <span class="absolute -top-6 left-4 flex h-12 w-12 items-center justify-center rounded-full border-4 border-surface bg-teal-soft text-teal-strong shadow">
                  <IconGlyph name={product.icon} class="h-5 w-5" />
                </span>
                <h3 class="text-lg font-bold text-ink">{product.name}</h3>
                <p class="mt-1 text-sm text-slate-gray">{product.tagline}</p>
                <ul class="mt-3 grid flex-1 content-start gap-1.5 text-sm text-ink">
                  {product.points.map((point) => (
                    <li class="flex min-w-0 gap-2">
                      <IconGlyph name="check" class="mt-0.5 h-4 w-4 shrink-0 text-teal-strong" strokeWidth={2.4} />
                      <span class="min-w-0">{point}</span>
                    </li>
                  ))}
                </ul>
                <p class="mt-4 flex items-baseline gap-2 border-t border-border-gray pt-3">
                  <span class="text-xs text-slate-gray">價格</span>
                  <span data-price-display class="text-lg font-bold text-deep-navy">{product.priceDisplay}</span>
                </p>
                <ButtonLink href={product.path} size="md" cta="product-detail" class="mt-3 w-full">
                  了解詳情
                  <span aria-hidden="true">→</span>
                </ButtonLink>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
    <p data-filter-empty="products" hidden class="mt-4 text-sm text-slate-gray">這個分類目前沒有產品，可以切換其他分類。</p>
  </Section>

  <!-- 產品功能比較 -->
  <Section tone="white" density="compact" id="comparison" name="comparison" labelledby="comparison-heading">
    <SectionHeading id="comparison-heading" title="產品功能比較" description="快速比較各產品的重點功能，找到符合需求的方案。" compact />
    <ComparisonTable columns={comparisonColumns} rows={comparisonRows} caption="森映產品功能比較表" />
    <ul class="mt-4 flex flex-wrap gap-2" aria-label="價格說明">
      {PRICING_NOTICE.map((notice) => <li class="rounded-full bg-teal-soft px-3 py-1 text-xs font-medium text-teal-strong">{notice}</li>)}
    </ul>
  </Section>

  <!-- 各產品適合的對象 -->
  <Section density="compact" name="audience" labelledby="audience-heading">
    <SectionHeading id="audience-heading" title="各產品適合的對象" description="依你的角色與目標，找到最接近的產品。" action={{ label: '看案例作品', href: '/cases' }} compact />
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {
        productAudiences.map((audience) => (
          <li class="min-w-0 overflow-hidden rounded-2xl border border-border-gray bg-surface shadow-card">
            <div class="flex items-center gap-3 bg-gradient-to-r from-[#0b1f3b] to-deep-navy-soft px-4 py-3 text-white">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-teal/20 text-teal">
                <IconGlyph name={audience.icon} class="h-5 w-5" />
              </span>
              <h3 class="min-w-0 font-bold">
                <a href={`/products/${audience.slug}`} class="hover:text-teal">{audience.name}</a>
              </h3>
            </div>
            <ul class="grid gap-2 p-4 text-sm text-ink">
              {audience.items.map((item) => (
                <li class="flex min-w-0 gap-2">
                  <IconGlyph name="check" class="mt-0.5 h-4 w-4 shrink-0 text-teal-strong" strokeWidth={2.4} />
                  <span class="min-w-0">{item}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- 3 步驟快速開始使用 -->
  <Section tone="white" density="compact" name="quick-start" labelledby="quick-start-heading">
    <SectionHeading id="quick-start-heading" title="3 步驟，快速開始使用" description="從諮詢到上線，每一步都有人協助。" compact />
    <ProcessTimeline steps={quickStartSteps} />
  </Section>

  <!-- 補充：FAQ（SEO 驗收要求） -->
  <FaqSection items={productsFaq} layout="grid" tone="mist" description="選產品、升級與價格的常見問題。" />

  <FinalCTA
    title={productsFinalCta.title}
    description={productsFinalCta.description}
    primary={productsFinalCta.primary}
    secondary={productsFinalCta.secondary}
    script={productsFinalCta.script}
    note={PRICING_NOTICE.join('・')}
  />
</BaseLayout>
