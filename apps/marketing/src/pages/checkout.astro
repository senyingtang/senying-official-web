---
import { webPageJsonLd } from '@syt/seo';
import { SANDBOX_PAYMENT_NOTICE, TEST_PRICE_NOTICE } from '@syt/database/commerce';
import ButtonLink from '../components/ButtonLink.astro';
import Container from '../components/Container.astro';
import FAQList from '../components/FAQList.astro';
import IconGlyph from '../components/IconGlyph.astro';
import MockupAlignedHero from '../components/MockupAlignedHero.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import Section from '../components/Section.astro';
import { checkoutFaq } from '../content/faqs';
import { PRICING_NOTICE, accessCodeSteps, checkoutFinalCta, checkoutTrust, planDisplay } from '../content/pricing';
import { products } from '../content/products';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBrandRuntime } from '../lib/brand-runtime';
import { getStorefront } from '../lib/commerce';
import { adminApiBase, siteUrl } from '../lib/site';

/**
 * 結帳（Phase 3.0）。
 *
 * 流程：購物車 → 客戶資料 → 付款方式 → 建立訂單（伺服器重算金額）→ 付款。
 * 這一頁不收集任何卡號 / CVV：正式金流由 provider 的頁面處理，本階段只有本機 Sandbox 模擬付款。
 */
const brand = await getBrandRuntime();
const storefront = await getStorefront();
const description = '確認購物車內容、填寫聯絡資料並選擇付款方式。目前僅開放本機 Sandbox 模擬付款，不會真的扣款。';
const breadcrumbs = [
  { label: '首頁', href: '/' },
  { label: '結帳', href: '/checkout' },
];
const cardClass = 'min-w-0 rounded-card border border-border-gray bg-surface p-5 shadow-card sm:p-6';
const labelClass = 'grid min-w-0 content-start gap-1.5';
const inputClass =
  'block min-h-11 w-full min-w-0 rounded-input border border-border-gray bg-surface px-3 py-2 text-base text-ink placeholder:text-slate-gray focus:border-teal-strong focus:outline-2 focus:outline-teal/40';
const selfServeProducts = products.filter((product) => ['seo-website', 'landing-page'].includes(product.slug));
const checkoutReady = storefront.checkoutAvailable && adminApiBase !== null;
---

<BaseLayout
  seo={{ title: '結帳｜確認方案與付款方式', description, path: '/checkout', noindex: true }}
  breadcrumbs={breadcrumbs}
  breadcrumbsInHero
  faq={checkoutFaq}
  jsonLd={[webPageJsonLd(siteUrl, { type: 'CheckoutPage', name: '森映結帳', description, path: '/checkout' }, brand.seo)]}
>
  <MockupAlignedHero
    eyebrow="CHECKOUT"
    title="確認方案，完成結帳"
    lead="金額由伺服器重新計算後開單。目前開放的是本機 Sandbox 模擬付款，不會真的扣款。"
    breadcrumbs={breadcrumbs}
    notice={SANDBOX_PAYMENT_NOTICE}
    facts={PRICING_NOTICE.map((notice, index) => ({ value: notice, label: ['價格狀態', '開始方式', '報價說明'][index] ?? '' }))}
  >
    <ButtonLink href="#order-summary" size="lg" cta="primary" fullWidthOnMobile>
      前往付款
      <span aria-hidden="true">→</span>
    </ButtonLink>
    <ButtonLink href="/contact" variant="ghost" size="lg" cta="secondary" fullWidthOnMobile class="border border-white/40 text-white hover:bg-white/10">預約討論</ButtonLink>
  </MockupAlignedHero>

  <div data-checkout-root data-admin-base={adminApiBase ?? ''} data-checkout-ready={String(checkoutReady)}>
    <!-- 購物車內容 -->
    <Section tone="white" density="compact" name="cart-review" labelledby="cart-review-heading">
      <h2 id="cart-review-heading" class="text-2xl font-bold text-ink">購物車內容</h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-gray">下面的金額只是顯示用；送出後由伺服器依資料庫價格重新計算。</p>

      <p data-checkout-mock hidden class="mt-4 rounded-card border border-warning/40 bg-warning/10 px-4 py-3 text-sm leading-relaxed text-ink">
        示範模式（未連線資料庫）：這個 build 無法建立訂單，請以 DATA_SOURCE=supabase 執行結帳驗收。
      </p>

      <ul data-checkout-lines hidden class="mt-5 grid gap-3"></ul>

      <div data-checkout-empty hidden class="mt-5 rounded-card border border-dashed border-border-gray bg-surface px-4 py-8">
        <p class="text-center text-base font-semibold text-ink">購物車目前是空的</p>
        <p class="mt-1 text-center text-sm text-slate-gray">可以先從下面的方案挑一個加入購物車。</p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {
            selfServeProducts.map((product) => (
              <li class="min-w-0 rounded-2xl border border-border-gray bg-surface p-4">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-teal-soft text-teal-strong">
                  <IconGlyph name={planDisplay[product.slug]?.icon ?? 'layout'} class="h-5 w-5" />
                </span>
                <h3 class="mt-3 text-base font-bold text-ink">{product.name}</h3>
                <p class="mt-1 text-sm text-slate-gray">{planDisplay[product.slug]?.audience ?? ''}</p>
                <a href={product.path} class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-teal-strong hover:underline">
                  看方案內容 <span aria-hidden="true" class="ml-1">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <p data-checkout-loading class="mt-5 rounded-card border border-border-gray bg-surface px-4 py-8 text-center text-sm text-slate-gray">購物車載入中…</p>
    </Section>

    <!-- 桌機：左側客戶資料 + 付款方式，右側 sticky 訂單摘要；手機：單欄 -->
    <div class="bg-mist-white">
      <Container class="grid gap-6 py-10 md:py-14 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] lg:items-start">
        <div class="grid min-w-0 gap-6">
          <!-- 客戶資料 -->
          <section data-section="customer" aria-labelledby="customer-heading" class={cardClass}>
            <h2 id="customer-heading" class="text-lg font-bold text-ink">客戶資料</h2>
            <p class="mt-1 text-sm text-slate-gray">用來寄送訂單與權限代碼；我們不會在這裡收集任何信用卡資訊。</p>
            <div class="mt-5 grid gap-4 md:grid-cols-2">
              <label class={labelClass}>
                <span class="text-sm font-medium text-ink">姓名 <span class="text-danger-strong">*</span></span>
                <input type="text" name="name" data-field="name" autocomplete="name" maxlength="120" required class={inputClass} />
                <span data-error="name" hidden class="text-xs text-danger-strong"></span>
              </label>
              <label class={labelClass}>
                <span class="text-sm font-medium text-ink">Email <span class="text-danger-strong">*</span></span>
                <input type="email" name="email" data-field="email" autocomplete="email" maxlength="254" required class={inputClass} />
                <span data-error="email" hidden class="text-xs text-danger-strong"></span>
              </label>
              <label class={labelClass}>
                <span class="text-sm font-medium text-ink">電話</span>
                <input type="tel" name="phone" data-field="phone" autocomplete="tel" maxlength="40" class={inputClass} />
                <span data-error="phone" hidden class="text-xs text-danger-strong"></span>
              </label>
              <label class={labelClass}>
                <span class="text-sm font-medium text-ink">公司名稱（選填）</span>
                <input type="text" name="company" data-field="company" autocomplete="organization" maxlength="200" class={inputClass} />
                <span data-error="company" hidden class="text-xs text-danger-strong"></span>
              </label>
              <label class={labelClass}>
                <span class="text-sm font-medium text-ink">統一編號（選填）</span>
                <input type="text" name="tax_id" data-field="taxId" inputmode="numeric" maxlength="8" pattern="[0-9]{8}" class={inputClass} />
                <span data-error="tax_id" hidden class="text-xs text-danger-strong"></span>
              </label>
              <label class:list={[labelClass, 'md:col-span-2']}>
                <span class="text-sm font-medium text-ink">備註（選填）</span>
                <textarea name="note" data-field="note" rows="3" maxlength="1000" class:list={[inputClass, 'min-h-24']}></textarea>
                <span data-error="note" hidden class="text-xs text-danger-strong"></span>
              </label>
            </div>
            <label class="mt-4 flex min-w-0 items-start gap-3">
              <input type="checkbox" name="consent" data-field="consent" class="mt-1 h-5 w-5 shrink-0 rounded border-border-gray text-teal-strong focus:outline-2 focus:outline-teal/40" />
              <span class="min-w-0 text-sm leading-relaxed text-ink">
                我已閱讀並同意<a href="/legal/privacy" class="font-semibold text-teal-strong hover:underline">隱私權政策</a>，同意森映以上述資料處理這筆訂單。
              </span>
            </label>
            <span data-error="consent" hidden class="mt-1 block text-xs text-danger-strong"></span>
          </section>

          <!-- 付款方式 -->
          <section data-section="payment-methods" aria-labelledby="payment-heading" class={cardClass}>
            <h2 id="payment-heading" class="text-lg font-bold text-ink">付款方式</h2>
            <p class="mt-1 text-sm text-slate-gray">只顯示已啟用的付款方式。正式金流（綠界、LINE Pay、銀行轉帳）尚未開放。</p>
            {
              storefront.paymentMethods.length === 0 ? (
                <p class="mt-4 rounded-xl bg-mist-white px-4 py-3 text-sm text-slate-gray">目前沒有可用的付款方式，請先預約討論。</p>
              ) : (
                <fieldset class="mt-4 grid gap-3">
                  <legend class="sr-only">選擇付款方式</legend>
                  {storefront.paymentMethods.map((method, index) => (
                    <label class="flex min-w-0 cursor-pointer items-start gap-3 rounded-xl border border-border-gray p-4 has-[:checked]:border-teal-strong has-[:checked]:bg-teal-soft">
                      <input
                        type="radio"
                        name="payment_method"
                        value={method.methodKey}
                        checked={index === 0}
                        data-payment-method
                        class="mt-1 h-5 w-5 shrink-0 text-teal-strong focus:outline-2 focus:outline-teal/40"
                      />
                      <span class="min-w-0">
                        <span class="flex flex-wrap items-center gap-2">
                          <span class="text-sm font-bold text-ink">{method.displayName}</span>
                          {method.isSimulation && <span class="rounded-full bg-warning/20 px-2 py-0.5 text-[11px] font-semibold text-ink">模擬付款</span>}
                        </span>
                        <span class="mt-1 block text-sm leading-relaxed text-slate-gray">{method.description}</span>
                      </span>
                    </label>
                  ))}
                </fieldset>
              )
            }
            <p class="mt-4 rounded-xl bg-warning/10 px-4 py-3 text-xs leading-relaxed text-ink">{SANDBOX_PAYMENT_NOTICE}</p>
            <p class="mt-2 text-xs leading-relaxed text-slate-gray">本站不會收集、也不會保存信用卡號或安全碼（CVV）。</p>
          </section>
        </div>

        <!-- 訂單摘要（桌機 sticky；手機在下方，付款按鈕不會被浮動快捷列遮住） -->
        <section data-section="order-summary" id="order-summary" aria-labelledby="summary-heading" class:list={[cardClass, 'lg:sticky lg:top-24']}>
          <div class="flex items-center justify-between gap-2">
            <h2 id="summary-heading" class="text-lg font-bold text-ink">訂單摘要</h2>
            <button type="button" data-summary-toggle aria-expanded="true" aria-controls="summary-body" class="inline-flex min-h-9 items-center text-sm font-semibold text-teal-strong lg:hidden">
              收合
            </button>
          </div>
          <div id="summary-body" data-summary-body class="mt-4 grid gap-2 text-sm">
            <div class="flex items-center justify-between gap-3">
              <span class="text-slate-gray">商品件數</span>
              <span class="font-semibold text-ink"><span data-summary-count>0</span> 件</span>
            </div>
            <div class="flex items-center justify-between gap-3">
              <span class="text-slate-gray">小計</span>
              <span class="font-semibold text-ink" data-summary-subtotal>—</span>
            </div>
            <div class="flex items-center justify-between gap-3 border-t border-border-gray pt-2">
              <span class="text-slate-gray">應付金額</span>
              <span class="text-xl font-bold text-ink" data-summary-total>—</span>
            </div>
            <p data-summary-test-price hidden class="rounded-lg bg-warning/10 px-3 py-2 text-xs leading-relaxed text-ink">{TEST_PRICE_NOTICE}</p>
          </div>
          <p data-checkout-error hidden role="alert" class="mt-4 rounded-lg border border-danger/40 bg-danger/10 px-3 py-2 text-sm text-ink"></p>
          <button
            type="button"
            data-checkout-submit
            disabled
            class="mt-5 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-button bg-teal px-6 font-semibold text-navy-black transition-colors hover:bg-teal-hover disabled:cursor-not-allowed disabled:opacity-60"
          >
            <span data-submit-label>前往付款（模擬）</span>
          </button>
          <p class="mt-3 text-xs leading-relaxed text-slate-gray">送出後會建立訂單，並導向本機 Sandbox 模擬付款頁。</p>
          <a href="/cart" class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-teal-strong hover:underline">回購物車修改</a>
        </section>
      </Container>
    </div>

    <!-- 權限代碼流程 -->
    <Section tone="white" density="compact" name="access-code" id="redeem" labelledby="redeem-heading">
      <h2 id="redeem-heading" class="text-2xl font-bold text-ink">權限代碼流程</h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-gray">付款成功後由伺服器發送權限代碼，登入客戶後台兌換即可開始建站。</p>
      <ProcessTimeline steps={accessCodeSteps} />
    </Section>

    <!-- 安心購買資訊 -->
    <Section density="compact" name="trust" labelledby="trust-heading">
      <h2 id="trust-heading" class="text-2xl font-bold text-ink">安心購買資訊</h2>
      <ul class="mt-6 grid gap-3 md:grid-cols-3">
        {
          checkoutTrust.map((item) => (
            <li class="min-w-0 rounded-2xl border border-border-gray bg-surface p-5 shadow-card">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-teal-soft text-teal-strong">
                <IconGlyph name={item.icon} class="h-5 w-5" />
              </span>
              <h3 class="mt-3 text-base font-bold text-ink">{item.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-slate-gray">{item.description}</p>
            </li>
          ))
        }
      </ul>
    </Section>
  </div>

  <!-- FAQ + CTA -->
  <section id="faq" data-section="faq" data-final-cta aria-labelledby="checkout-faq-heading" class="scroll-mt-20 bg-surface py-10 md:py-14">
    <Container class="grid gap-8 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] lg:items-start">
      <div class="min-w-0">
        <h2 id="checkout-faq-heading" class="text-2xl font-bold text-ink">常見問題</h2>
        <div class="mt-5"><FAQList items={checkoutFaq} /></div>
      </div>
      <div class="min-w-0 rounded-card border border-border-gray bg-mist-white p-5 shadow-card sm:p-6">
        <h3 class="text-lg font-bold text-ink">{checkoutFinalCta.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-gray">{checkoutFinalCta.description}</p>
        <ButtonLink href={checkoutFinalCta.primary.href} cta="primary" class="mt-4 w-full">{checkoutFinalCta.primary.label}</ButtonLink>
        <ButtonLink href="line" variant="secondary" class="mt-2 w-full">LINE@ 詢問</ButtonLink>
      </div>
    </Container>
  </section>

  <script type="application/json" data-cart-catalog set:html={JSON.stringify(storefront.products)} is:inline />
</BaseLayout>

<script>
  import { formatMoneyFromCents } from '@syt/shared';
  import type { BuyerInput, CartState } from '@syt/database/commerce';
  import { validateBuyerInput } from '@syt/database/commerce';
  import { CartRpcError, createCartClient } from '../lib/cart-client';
  import { CHECKOUT_TOKEN_STORAGE_KEY } from '../lib/checkout-session';

  const root = document.querySelector<HTMLElement>('[data-checkout-root]');
  if (root) {
    const catalogEl = document.querySelector<HTMLScriptElement>('[data-cart-catalog]');
    let catalog = [];
    try {
      catalog = JSON.parse(catalogEl?.textContent ?? '[]');
    } catch {
      catalog = [];
    }
    const client = createCartClient(catalog);
    const adminBase = root.dataset.adminBase ?? '';
    const ready = root.dataset.checkoutReady === 'true' && !client.isMock && adminBase !== '';

    const el = (selector: string) => root.querySelector<HTMLElement>(selector);
    const loading = el('[data-checkout-loading]');
    const lines = root.querySelector<HTMLUListElement>('[data-checkout-lines]');
    const empty = el('[data-checkout-empty]');
    const submit = root.querySelector<HTMLButtonElement>('[data-checkout-submit]');
    const errorBox = el('[data-checkout-error]');
    const mockNotice = el('[data-checkout-mock]');
    if (mockNotice) mockNotice.hidden = !client.isMock;

    const field = (name: string) => root.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-field="${name}"]`);
    const readBuyer = (): BuyerInput => ({
      name: field('name')?.value ?? '',
      email: field('email')?.value ?? '',
      phone: field('phone')?.value ?? '',
      company: field('company')?.value ?? '',
      taxId: field('taxId')?.value ?? '',
      note: field('note')?.value ?? '',
      consent: (field('consent') as HTMLInputElement | null)?.checked ?? false,
    });

    const showErrors = (errors: Record<string, string>) => {
      for (const node of root.querySelectorAll<HTMLElement>('[data-error]')) {
        const key = node.dataset.error ?? '';
        const message = errors[key];
        node.textContent = message ?? '';
        node.hidden = !message;
      }
    };
    const showError = (message: string) => {
      if (!errorBox) return;
      errorBox.textContent = message;
      errorBox.hidden = false;
    };
    const clearError = () => {
      if (errorBox) errorBox.hidden = true;
    };

    let cartCount = 0;
    const render = (state: CartState) => {
      cartCount = state.itemCount;
      if (loading) loading.hidden = true;
      const hasItems = state.items.length > 0;
      if (empty) empty.hidden = hasItems;
      if (lines) {
        lines.hidden = !hasItems;
        lines.replaceChildren();
        for (const item of state.items) {
          const li = document.createElement('li');
          li.className = 'flex min-w-0 flex-wrap items-center justify-between gap-2 rounded-2xl border border-border-gray bg-surface p-4';
          const left = document.createElement('div');
          left.className = 'min-w-0';
          const name = document.createElement('p');
          name.className = 'text-base font-bold text-ink';
          name.textContent = item.productName;
          const meta = document.createElement('p');
          meta.className = 'mt-1 text-xs text-slate-gray';
          meta.textContent = `${item.sku} · ${item.priceName} · 數量 ${item.quantity}`;
          left.append(name, meta);
          const total = document.createElement('p');
          total.className = 'text-base font-bold text-ink';
          total.textContent = formatMoneyFromCents(item.lineTotalCents, item.currency);
          li.append(left, total);
          lines.append(li);
        }
      }
      const count = el('[data-summary-count]');
      if (count) count.textContent = String(state.itemCount);
      const subtotal = el('[data-summary-subtotal]');
      if (subtotal) subtotal.textContent = formatMoneyFromCents(state.subtotalCents, state.currency);
      const totalEl = el('[data-summary-total]');
      if (totalEl) totalEl.textContent = formatMoneyFromCents(state.subtotalCents, state.currency);
      const testPrice = el('[data-summary-test-price]');
      if (testPrice) testPrice.hidden = !state.hasTestPrice;
      if (submit) {
        submit.disabled = !ready || !hasItems || state.hasUnavailableItem;
        const label = el('[data-submit-label]');
        if (label) label.textContent = !ready ? '結帳尚未開放' : hasItems ? '前往付款（模擬）' : '購物車是空的';
      }
    };

    // 手機：訂單摘要可折疊
    el('[data-summary-toggle]')?.addEventListener('click', (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const body = el('[data-summary-body]');
      if (!body) return;
      const expanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!expanded));
      button.textContent = expanded ? '展開' : '收合';
      body.hidden = expanded;
    });

    submit?.addEventListener('click', async () => {
      clearError();
      const buyer = readBuyer();
      const validation = validateBuyerInput(buyer);
      showErrors(validation.errors);
      if (!validation.ok) {
        showError('請先修正表單中的欄位。');
        return;
      }
      if (cartCount === 0) {
        showError('購物車是空的。');
        return;
      }
      const checkedMethod = root.querySelector<HTMLInputElement>('[data-payment-method]:checked');
      const method = checkedMethod ? checkedMethod.value : '';
      if (!method) {
        showError('請選擇付款方式。');
        return;
      }
      submit.disabled = true;
      const label = el('[data-submit-label]');
      if (label) label.textContent = '建立訂單中…';
      try {
        const order = await client.createOrder(buyer, method);
        // 收據 token 只留在瀏覽器，不放進跨網域的網址
        try {
          window.sessionStorage.setItem(CHECKOUT_TOKEN_STORAGE_KEY, order.publicToken);
        } catch {
          // sessionStorage 不可用時，成功頁會提示以 Email 查詢訂單
        }
        window.location.href = `${adminBase}/api/payments/sandbox/${order.paymentId}?return_base=${encodeURIComponent(window.location.origin)}`;
      } catch (error) {
        submit.disabled = false;
        if (label) label.textContent = '前往付款（模擬）';
        showError(error instanceof CartRpcError ? error.message : '建立訂單失敗，請稍後再試。');
      }
    });

    void (async () => {
      try {
        render(await client.get());
      } catch {
        if (loading) loading.hidden = true;
        showError('購物車載入失敗，請重新整理頁面。');
      }
    })();
  }
</script>
