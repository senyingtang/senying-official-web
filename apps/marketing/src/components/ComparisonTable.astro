---
import type { IconName } from '../content/types';
import IconGlyph from './IconGlyph.astro';

interface Props {
  columns: { key: string; label: string; icon: IconName; href?: string }[];
  rows: { label: string; values: string[] }[];
  caption: string;
}

/**
 * 產品功能比較表：md 以上為表格（放在可橫向捲動的容器內），手機改成每個產品一張比較卡，不產生水平捲軸。
 */
const { columns, rows, caption } = Astro.props;
const mark = (value: string) => value === '✓';
---

<div data-comparison-table class="hidden overflow-x-auto rounded-card border border-border-gray bg-surface shadow-card md:block">
  <table class="w-full min-w-[720px] border-collapse text-sm">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr class="border-b border-border-gray bg-mist-white">
        <th scope="col" class="w-28 px-4 py-3 text-left font-semibold text-ink">功能項目</th>
        {
          columns.map((column) => (
            <th scope="col" class="px-3 py-3 text-center font-semibold text-ink">
              <span class="inline-flex items-center gap-2">
                <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-teal-soft text-teal-strong">
                  <IconGlyph name={column.icon} class="h-4 w-4" />
                </span>
                {column.href ? <a href={column.href} class="hover:text-teal-strong">{column.label}</a> : column.label}
              </span>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr class="border-b border-border-gray last:border-b-0">
            <th scope="row" class="px-4 py-3 text-left font-semibold text-ink">{row.label}</th>
            {row.values.map((value) => (
              <td class="px-3 py-3 text-center text-slate-gray">
                {mark(value) ? (
                  <span class="inline-flex text-teal-strong">
                    <IconGlyph name="check" class="h-5 w-5" strokeWidth={2.4} />
                    <span class="sr-only">支援</span>
                  </span>
                ) : (
                  value
                )}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<ul data-comparison-cards class="grid gap-3 md:hidden" aria-label={caption}>
  {
    columns.map((column, columnIndex) => (
      <li class="min-w-0 rounded-card border border-border-gray bg-surface p-4 shadow-card">
        <p class="flex items-center gap-2 font-bold text-ink">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-teal-soft text-teal-strong">
            <IconGlyph name={column.icon} class="h-4 w-4" />
          </span>
          {column.href ? <a href={column.href} class="hover:text-teal-strong">{column.label}</a> : column.label}
        </p>
        <dl class="mt-3 grid gap-2 text-sm">
          {rows.map((row) => (
            <div class="grid grid-cols-[5.5rem_minmax(0,1fr)] gap-2 border-t border-border-gray pt-2">
              <dt class="font-medium text-ink">{row.label}</dt>
              <dd class="text-slate-gray">{mark(row.values[columnIndex] ?? '') ? '支援' : row.values[columnIndex]}</dd>
            </div>
          ))}
        </dl>
      </li>
    ))
  }
</ul>
