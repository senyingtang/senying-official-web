---
import { resolveVisibleSocials, type SocialPlatform } from '@syt/database/site-settings';
import type { IconName } from '../lib/icons';
import BrandLockup from './BrandLockup.astro';
import Container from './Container.astro';
import IconGlyph from './IconGlyph.astro';
import { getBrandRuntime } from '../lib/brand-runtime';
import { footerGroups, lineIsExternal, lineOaUrl } from '../lib/site';
import { getMarketingNavigation } from '../lib/navigation-runtime';
import { getMarketingSiteSettings } from '../lib/site-settings';

const year = new Date().getFullYear();
const { legal: legalLinks } = await getMarketingNavigation();
const { socials } = await getMarketingSiteSettings();
const brand = await getBrandRuntime();
const visibleSocials = resolveVisibleSocials(socials, 'any');

const resolve = (href: string) =>
  href === 'line'
    ? { href: lineOaUrl, external: lineIsExternal }
    : { href, external: false };

const icons: Record<SocialPlatform, IconName> = {
  line: 'message',
  facebook: 'facebook',
  instagram: 'instagram',
  threads: 'threads',
  youtube: 'youtube',
  tiktok: 'tiktok',
  email: 'mail',
  phone: 'phone',
};
---

<footer data-section="footer" class="bg-[#0b1f3b] text-slate-300">
  <Container
    class="grid grid-cols-2 gap-x-6 gap-y-8 py-9 md:grid-cols-2 md:gap-10 md:py-12 lg:grid-cols-[minmax(0,1.3fr)_repeat(3,minmax(0,0.8fr))_minmax(0,1.1fr)] lg:gap-8 lg:py-14"
  >
    <!-- Brand：手機全寬 -->
    <div class="col-span-2 min-w-0 md:col-span-1">
      <BrandLockup variant="footer" />
      <p class="mt-3 max-w-md text-sm leading-relaxed md:mt-4">
        讓每個想法，都能成為被看見的數位產品。
      </p>
      <p class="mt-2 max-w-md text-xs leading-relaxed text-slate-400">
        {brand.description}
      </p>
    </div>

    {
      footerGroups.map((group, index) => (
        <nav
          aria-label={group.title}
          class:list={[
            'min-w-0',
            index === 2 && 'col-span-2 md:col-span-1',
          ]}
        >
          <p class="text-sm font-semibold text-white">{group.title}</p>

          <ul
            class:list={[
              'mt-3 grid gap-x-4 gap-y-0',
              index === 2 ? 'grid-cols-2 md:grid-cols-1' : 'grid-cols-1',
            ]}
          >
            {group.links.map((link) => {
              const target = resolve(link.href);

              return (
                <li class="min-w-0">
                  <a
                    href={target.href}
                    target={target.external ? '_blank' : undefined}
                    rel={target.external ? 'noopener noreferrer' : undefined}
                    class="inline-flex min-h-9 items-center text-sm leading-snug hover:text-teal"
                  >
                    {link.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      ))
    }

    <!-- 社群：手機全寬 -->
    <div class="col-span-2 min-w-0 md:col-span-2 lg:col-span-1">
      <p class="text-sm font-semibold text-white">社群</p>

      {
        visibleSocials.length > 0 ? (
          <ul
            class="mt-3 flex flex-wrap gap-2"
            aria-label={`${brand.nameEn} 社群與聯絡方式`}
          >
            {visibleSocials.map((item) => (
              <li>
                <a
                  href={item.url}
                  data-social={item.platform}
                  target={
                    item.openInNewTab && /^https?:\/\//.test(item.url)
                      ? '_blank'
                      : undefined
                  }
                  rel={
                    item.openInNewTab && /^https?:\/\//.test(item.url)
                      ? 'noopener noreferrer'
                      : undefined
                  }
                  aria-label={item.label}
                  title={item.label}
                  class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-white/5 text-slate-200 transition-colors hover:border-teal/60 hover:text-teal"
                >
                  <IconGlyph
                    name={icons[item.platform]}
                    class="h-4 w-4"
                  />
                </a>
              </li>
            ))}
          </ul>
        ) : null
      }

      <p class="mt-2 text-xs text-slate-400">
        其他社群帳號開通後會更新連結。
      </p>
    </div>
  </Container>

  <div class="border-t border-white/10">
    <Container
      class="grid gap-3 py-5 text-xs text-slate-400 md:flex md:items-center md:justify-between"
    >
      <p>
        © {year} {brand.footerName}. All rights reserved.
      </p>

      <ul class="flex flex-wrap items-center gap-x-4 gap-y-1">
        {
          legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-flex min-h-8 items-center hover:text-teal"
              >
                {link.label}
              </a>
            </li>
          ))
        }

        <li class="w-full text-slate-500 md:w-auto">
          方案整理中，正式價格以確認報價為準
        </li>
      </ul>
    </Container>
  </div>
</footer>
