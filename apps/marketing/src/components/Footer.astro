---
import { resolveVisibleSocials, type SocialPlatform } from '@syt/database/site-settings';
import type { IconName } from '../lib/icons';
import BrandLockup from './BrandLockup.astro';
import Container from './Container.astro';
import IconGlyph from './IconGlyph.astro';
import { getBrandRuntime } from '../lib/brand-runtime';
import { footerGroups, legalLinks, lineIsExternal, lineOaUrl } from '../lib/site';
import { getMarketingSiteSettings } from '../lib/site-settings';

const year = new Date().getFullYear();
const { socials } = await getMarketingSiteSettings();
const brand = await getBrandRuntime();
const visibleSocials = resolveVisibleSocials(socials, 'any');
const resolve = (href: string) => (href === 'line' ? { href: lineOaUrl, external: lineIsExternal } : { href, external: false });
const icons: Record<SocialPlatform, IconName> = {
  line: 'message',
  facebook: 'facebook',
  instagram: 'instagram',
  threads: 'threads',
  youtube: 'youtube',
  tiktok: 'tiktok',
  email: 'mail',
  phone: 'phone',
};
---

<!-- 深色 Footer：品牌名稱、產品服務、資源、關於我們、社群連結（全站設定）、法律連結 -->
<footer data-section="footer" class="bg-[#0b1f3b] text-slate-300">
  <Container class="grid gap-10 py-12 md:grid-cols-2 lg:grid-cols-[minmax(0,1.3fr)_repeat(3,minmax(0,0.8fr))_minmax(0,1.1fr)] lg:gap-8 lg:py-14">
    <div class="min-w-0">
      <BrandLockup variant="footer" />
      <p class="mt-4 max-w-xs text-sm leading-relaxed">讓每個想法，都能成為被看見的數位產品。</p>
      <p class="mt-2 max-w-xs text-xs leading-relaxed text-slate-400">{brand.description}</p>
    </div>
    {
      footerGroups.map((group) => (
        <nav aria-label={group.title} class="min-w-0">
          <p class="text-sm font-semibold text-white">{group.title}</p>
          <ul class="mt-3 grid gap-1">
            {group.links.map((link) => {
              const target = resolve(link.href);
              return (
                <li>
                  <a
                    href={target.href}
                    target={target.external ? '_blank' : undefined}
                    rel={target.external ? 'noopener noreferrer' : undefined}
                    class="inline-flex min-h-9 items-center text-sm hover:text-teal"
                  >
                    {link.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      ))
    }
    <div class="min-w-0 md:col-span-2 lg:col-span-1">
      <p class="text-sm font-semibold text-white">社群</p>
      {
        visibleSocials.length > 0 ? (
          <ul class="mt-3 flex flex-wrap gap-2" aria-label={`${brand.nameEn} 社群與聯絡方式`}>
            {visibleSocials.map((item) => (
              <li>
                <a
                  href={item.url}
                  data-social={item.platform}
                  target={item.openInNewTab && /^https?:\/\//.test(item.url) ? '_blank' : undefined}
                  rel={item.openInNewTab && /^https?:\/\//.test(item.url) ? 'noopener noreferrer' : undefined}
                  aria-label={item.label}
                  title={item.label}
                  class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-white/5 text-slate-200 transition-colors hover:border-teal/60 hover:text-teal"
                >
                  <IconGlyph name={icons[item.platform]} class="h-4 w-4" />
                </a>
              </li>
            ))}
          </ul>
        ) : null
      }
      <p class="mt-2 text-xs text-slate-400">其他社群帳號開通後會更新連結。</p>
    </div>
  </Container>
  <div class="border-t border-white/10">
    <Container class="flex flex-col gap-3 py-5 text-xs text-slate-400 md:flex-row md:items-center md:justify-between">
      <p>© {year} {brand.footerName}. All rights reserved.</p>
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-1">
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href} class="inline-flex min-h-9 items-center hover:text-teal">
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="text-slate-500">方案整理中，正式價格以確認報價為準</li>
      </ul>
    </Container>
  </div>
</footer>
