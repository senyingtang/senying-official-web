---
import ButtonLink from './ButtonLink.astro';
import Container from './Container.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import VisualGlow from './VisualGlow.astro';
import { IMAGE_SIZES } from '../lib/image-variants';
import { mediaAssets } from '../content/media';
import { lineIsExternal, lineOaUrl, portalIsExternal, portalLoginUrl } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '先聊聊你的網站要做什麼',
  description = '還在比較產品也沒關係。說明目的、現有素材與時程，我們會建議適合自助建站或客製的做法。',
} = Astro.props;

const options = [
  { label: 'LINE@ 詢問', description: '方案、報價與開通問題，回覆最快。', href: lineOaUrl, external: lineIsExternal },
  { label: '進入客戶後台', description: '已經有權限代碼，直接登入兌換。', href: portalLoginUrl, external: portalIsExternal },
];
---

<section data-section="cta" class="bg-mist-white py-14 md:py-20" aria-labelledby="contact-cta-heading">
  <Container>
    <div class="relative overflow-hidden rounded-card border border-white/10 bg-navy-black px-5 py-10 text-white sm:px-10 md:py-14">
      <!-- 深色山景背景（裝飾、lazy），深色 overlay 確保文字可讀；手機降低可視度 -->
      <ResponsiveImage
        src={mediaAssets.backgroundDark.src}
        alt=""
        width={mediaAssets.backgroundDark.width}
        height={mediaAssets.backgroundDark.height}
        loading="lazy"
        sizes={IMAGE_SIZES.background}
        class="absolute inset-0 h-full w-full opacity-40 md:opacity-80"
      />
      <div
        aria-hidden="true"
        class="absolute inset-0 bg-gradient-to-b from-navy-black/90 via-navy-black/80 to-navy-black/95 md:bg-gradient-to-r md:from-navy-black/95 md:via-navy-black/75 md:to-navy-black/40"
      >
      </div>
      <VisualGlow variant="section" grid />
      <div class="relative grid gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:items-center">
        <div class="min-w-0">
          <p class="text-sm font-semibold tracking-wide text-teal">下一步</p>
          <h2 id="contact-cta-heading" class="mt-2 text-2xl font-bold leading-tight sm:text-3xl lg:text-4xl">{title}</h2>
          <p class="mt-3 text-base leading-relaxed text-slate-300 sm:text-lg">{description}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <ButtonLink href="/contact" size="lg" cta="primary" fullWidthOnMobile>預約討論</ButtonLink>
            <ButtonLink href="/products" variant="ghost" size="lg" cta="secondary" fullWidthOnMobile class="border border-white/30 text-white hover:bg-white/10">
              查看產品方案
            </ButtonLink>
          </div>
        </div>
        <ul class="grid min-w-0 gap-3">
          {
            options.map((option) => (
              <li class="min-w-0">
                <a
                  href={option.href}
                  target={option.external ? '_blank' : undefined}
                  rel={option.external ? 'noopener noreferrer' : undefined}
                  class="syt-hover-glow flex min-w-0 items-center justify-between gap-4 rounded-2xl border border-white/10 bg-white/5 p-4 transition-colors hover:border-teal/40 sm:p-5"
                >
                  <span class="min-w-0">
                    <span class="block font-semibold text-white">{option.label}</span>
                    <span class="mt-1 block text-sm text-slate-300">{option.description}</span>
                  </span>
                  <span class="shrink-0 text-teal" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</section>
