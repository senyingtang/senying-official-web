---
interface Props {
  /** 示意網址（使用 .example 保留網域，不寫真實網域） */
  url?: string;
  tone?: 'light' | 'dark';
  device?: 'browser' | 'phone';
  /** 有 label 時整個框視為一張示意圖（role="img"） */
  label?: string;
  class?: string;
}

const { url = 'your-brand.example', tone = 'light', device = 'browser', label, class: className = '' } = Astro.props;
const dark = tone === 'dark';
---

{
  device === 'phone' ? (
    <div
      role={label ? 'img' : undefined}
      aria-label={label}
      class:list={['mx-auto w-full max-w-[250px] rounded-[2rem] border-[6px] border-slate-800 bg-slate-900 p-1.5 shadow-2xl shadow-black/30', className]}
    >
      <div class="mx-auto mb-1.5 h-1.5 w-14 rounded-full bg-slate-600" aria-hidden="true" />
      <div class="overflow-hidden rounded-[1.4rem] bg-surface">
        <slot />
      </div>
    </div>
  ) : (
    <div
      role={label ? 'img' : undefined}
      aria-label={label}
      class:list={[
        'min-w-0 overflow-hidden rounded-2xl border shadow-2xl',
        dark ? 'border-white/10 bg-deep-navy shadow-black/40' : 'border-white/60 bg-surface shadow-black/20',
        className,
      ]}
    >
      <div class:list={['flex items-center gap-2 border-b px-3 py-2', dark ? 'border-white/10 bg-white/5' : 'border-border-gray bg-mist-white']} aria-hidden="true">
        <span class="flex shrink-0 gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-danger/70" />
          <span class="h-2.5 w-2.5 rounded-full bg-warning/70" />
          <span class="h-2.5 w-2.5 rounded-full bg-success/70" />
        </span>
        <span class:list={['min-w-0 flex-1 truncate rounded-md px-2 py-1 font-mono text-[11px]', dark ? 'bg-white/5 text-slate-400' : 'bg-surface text-slate-gray']}>{url}</span>
      </div>
      <div class="min-w-0">
        <slot />
      </div>
    </div>
  )
}
