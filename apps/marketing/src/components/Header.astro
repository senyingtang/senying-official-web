---
import BrandLockup from './BrandLockup.astro';
import ButtonLink from './ButtonLink.astro';
import Container from './Container.astro';
import IconGlyph from './IconGlyph.astro';
import { headerActions, portalIsExternal, portalLoginUrl } from '../lib/site';
import { getMarketingNavigation } from '../lib/navigation-runtime';

// 主選單：supabase 模式讀 cms_navigation_items（後台改完重新建置即反映）；mock 模式使用設計預設值
const { main: mainNav } = await getMarketingNavigation();
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
const portalTarget = portalIsExternal ? '_blank' : undefined;
const portalRel = portalIsExternal ? 'noopener noreferrer' : undefined;
---

<!-- 深色玻璃 Header（設計稿區塊 1）：Logo 左、主選單中、搜尋 / 登入 / 立即開始右；手機收進漢堡選單，不擠壓 -->
<header data-section="header" class="syt-glass-header sticky top-0 z-40 border-b border-white/10 text-white">
  <Container class="flex h-16 items-center justify-between gap-3 lg:h-[72px]">
    <BrandLockup variant="header" />

    <nav aria-label="主選單" class="hidden lg:block">
      <ul class="flex items-center gap-1 xl:gap-3">
        {
          mainNav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'relative inline-flex min-h-11 items-center px-3 text-sm font-medium transition-colors hover:text-teal',
                  isActive(item.href) ? 'text-teal after:absolute after:inset-x-3 after:bottom-1.5 after:h-0.5 after:rounded-full after:bg-teal' : 'text-slate-200',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden shrink-0 items-center gap-2 lg:flex">
      <a
        href={headerActions.search.href}
        data-header-action="search"
        class="flex h-10 w-10 items-center justify-center rounded-full text-slate-200 transition-colors hover:bg-white/10 hover:text-white"
        aria-label={headerActions.search.label}
      >
        <IconGlyph name="search" class="h-5 w-5" />
        <span class="sr-only">搜尋</span>
      </a>
      <a
        href={portalLoginUrl}
        target={portalTarget}
        rel={portalRel}
        data-header-action="login"
        class="inline-flex min-h-9 items-center rounded-button border border-white/40 px-4 text-sm font-medium text-white transition-colors hover:bg-white/10"
      >
        {headerActions.login.label}
      </a>
      <ButtonLink href={headerActions.start.href} size="sm" cta="header-start" class="px-4">{headerActions.start.label}</ButtonLink>
    </div>

    <div class="flex shrink-0 items-center gap-1 lg:hidden">
      <a
        href={headerActions.search.href}
        class="flex h-11 w-11 items-center justify-center rounded-lg text-slate-200 hover:bg-white/10"
        aria-label={headerActions.search.label}
      >
        <IconGlyph name="search" class="h-5 w-5" />
      </a>
      <!-- 手機選單：原生 details，不需 JS -->
      <details class="group">
        <summary
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg hover:bg-white/10 [&::-webkit-details-marker]:hidden"
          aria-label="開啟選單"
        >
          <svg class="h-6 w-6 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg class="hidden h-6 w-6 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18"></path>
          </svg>
        </summary>
        <div class="absolute inset-x-0 top-full max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-white/10 bg-navy-black shadow-card">
          <Container class="py-4">
            <nav aria-label="手機主選單">
              <ul class="grid gap-1">
                {
                  mainNav.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        aria-current={isActive(item.href) ? 'page' : undefined}
                        class:list={['flex min-h-11 items-center rounded-lg px-3 text-base hover:bg-white/10', isActive(item.href) ? 'text-teal' : 'text-slate-100']}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
            <div class="mt-4 grid grid-cols-2 gap-2">
              <a
                href={portalLoginUrl}
                target={portalTarget}
                rel={portalRel}
                class="flex min-h-11 items-center justify-center rounded-button border border-white/30 text-sm font-medium text-white hover:bg-white/10"
              >
                {headerActions.login.label}
              </a>
              <ButtonLink href={headerActions.start.href} class="w-full">{headerActions.start.label}</ButtonLink>
            </div>
          </Container>
        </div>
      </details>
    </div>
  </Container>
</header>
