---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  level?: 'h2' | 'h3';
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
  /** compact：設計稿的密集標題（字級較小、間距較緊） */
  compact?: boolean;
  /** 標題右側的「查看更多 →」連結 */
  action?: { label: string; href: string };
}

const { id, eyebrow, title, description, level: Heading = 'h2', align = 'left', tone = 'light', compact = false, action } = Astro.props;
const dark = tone === 'dark';
---

<div
  class:list={[
    compact ? 'mb-6 md:mb-8' : 'mb-8 md:mb-10',
    action ? 'flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between' : align === 'center' ? 'mx-auto max-w-3xl text-center' : 'max-w-3xl',
  ]}
>
  <div class:list={['min-w-0', action && 'max-w-3xl']}>
    {eyebrow && <p class:list={['mb-2 text-sm font-semibold tracking-wide', dark ? 'text-teal' : 'text-teal-strong']}>{eyebrow}</p>}
    <Heading id={id} class:list={['font-bold leading-tight', compact ? 'text-2xl sm:text-[1.75rem]' : 'text-2xl sm:text-3xl lg:text-4xl']}>{title}</Heading>
    {
      description && (
        <p class:list={[compact ? 'mt-2 text-sm leading-relaxed sm:text-base' : 'mt-3 text-base leading-relaxed sm:text-lg', dark ? 'text-slate-300' : 'text-slate-gray']}>
          {description}
        </p>
      )
    }
  </div>
  {
    action && (
      <a
        href={action.href}
        class:list={['inline-flex min-h-11 shrink-0 items-center gap-1 text-sm font-semibold hover:underline', dark ? 'text-teal' : 'text-teal-strong']}
      >
        {action.label}
        <span aria-hidden="true">→</span>
      </a>
    )
  }
</div>
