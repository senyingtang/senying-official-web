---
import { badgeClass } from '@syt/ui';
import type { ShowcaseItem } from '../content/types';
import MockPageWireframe from './MockPageWireframe.astro';

interface Props {
  items: ShowcaseItem[];
  columns?: 1 | 2 | 3;
  headingLevel?: 'h2' | 'h3';
}

const { items, columns = 3, headingLevel: Heading = 'h3' } = Astro.props;
---

<div class:list={['grid gap-5', columns !== 1 && 'sm:grid-cols-2', columns === 3 && 'lg:grid-cols-3']}>
  {
    items.map((item) => (
      <article class="syt-hover-glow group flex h-full min-w-0 flex-col overflow-hidden rounded-card border border-border-gray bg-surface shadow-card transition-shadow hover:shadow-card-hover">
        <div class="border-b border-border-gray bg-gradient-to-br from-mist-white to-teal-soft px-6 pt-5">
          <MockPageWireframe variant={item.visual} class="mx-auto h-36 max-w-[240px] rounded-t-xl border border-b-0 border-border-gray" />
        </div>
        <div class="flex flex-1 flex-col p-5 sm:p-6">
          <div class="flex flex-wrap gap-2">
            {item.category && <span class={badgeClass('neutral')}>{item.category}</span>}
            <span class={badgeClass('teal')}>{item.badge}</span>
          </div>
          <Heading class="mt-3 text-lg font-bold text-ink sm:text-xl">
            <a href={item.href} class="after:absolute after:inset-0 after:rounded-card focus-visible:outline-none">
              {item.name}
            </a>
          </Heading>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-gray sm:text-base">{item.summary}</p>
          {item.tags.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={`${item.name} 重點`}>
              {item.tags.map((tag) => (
                <li class="rounded-full bg-mist-white px-2.5 py-1 text-xs text-slate-gray">{tag}</li>
              ))}
            </ul>
          )}
          <p class="mt-5 text-sm font-semibold text-teal-strong">查看產品內容 →</p>
        </div>
      </article>
    ))
  }
</div>
