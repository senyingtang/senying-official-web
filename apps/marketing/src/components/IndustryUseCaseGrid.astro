---
import { badgeClass } from '@syt/ui';
import type { SolutionScenario } from '../content/solutions';

interface Props {
  items: SolutionScenario[];
}

const { items } = Astro.props;
---

<div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
  {
    items.map((item, index) => (
      <article id={item.key} class="syt-hover-glow flex h-full min-w-0 scroll-mt-24 flex-col rounded-card border border-border-gray bg-surface p-5 shadow-card sm:p-6">
        <div class="flex items-center justify-between gap-3">
          <span class={badgeClass('teal')}>{item.tag}</span>
          <span class="font-mono text-xs text-slate-gray">{String(index + 1).padStart(2, '0')}</span>
        </div>
        <h3 class="mt-3 text-xl font-bold text-ink">{item.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-gray">{item.situation}</p>
        <p class="mt-4 text-xs font-semibold text-ink">通常需要</p>
        <ul class="mt-2 grid gap-1.5 text-sm text-ink">
          {item.needs.map((need) => (
            <li class="flex min-w-0 gap-2">
              <span class="text-teal-strong" aria-hidden="true">
                ✓
              </span>
              <span class="min-w-0">{need}</span>
            </li>
          ))}
        </ul>
        <p class="mt-4 rounded-xl bg-mist-white p-3 text-sm leading-relaxed text-ink">
          <span class="font-semibold text-teal-strong">第一步：</span>
          {item.firstStep}
        </p>
        <div class="mt-auto pt-5">
          <p class="text-xs font-semibold text-slate-gray">建議產品</p>
          <ul class="mt-2 flex flex-wrap gap-2">
            {item.recommended.map((link) => (
              <li>
                <a href={link.href} class="inline-flex min-h-9 items-center rounded-full border border-teal/40 px-3 text-sm font-medium text-teal-strong transition-colors hover:bg-teal-soft">
                  {link.label} →
                </a>
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))
  }
</div>
