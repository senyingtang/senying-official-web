---
import type { BlogPostSummary } from '@syt/database/cms-content';
import { blogCategoryPresentation } from '../content/blogPosts';
import { formatPublishedDate, isoDate } from '../lib/cms';
import PosterTile from './PosterTile.astro';
import ContentImage from './ContentImage.astro';

interface Props {
  post: BlogPostSummary;
  categoryLabel: string;
  readingMinutes?: number;
  headingLevel?: 'h2' | 'h3' | 'h4';
}

/** 文章卡：整張卡連到文章頁；沒有封面圖時用分類色塊示意 */
const { post, categoryLabel, readingMinutes, headingLevel: Heading = 'h3' } = Astro.props;
const presentation = blogCategoryPresentation(post.categorySlug);
const href = `/blog/${post.slug}`;
const published = formatPublishedDate(post.publishedAt);
---

<article data-blog-card class="syt-hover-glow flex h-full min-w-0 flex-col overflow-hidden rounded-2xl border border-border-gray bg-surface shadow-card transition-colors hover:border-teal/50">
  <div class="relative aspect-[16/9] overflow-hidden">
    {
      post.coverImageUrl ? (
        <ContentImage src={post.coverImageUrl} alt={post.title} />
      ) : (
        <PosterTile poster={{ headline: post.title.slice(0, 12), sub: categoryLabel || '森映文章', theme: presentation.theme }} />
      )
    }
    {categoryLabel && <span class="absolute bottom-2 left-2 rounded-full bg-teal px-2.5 py-0.5 text-[11px] font-semibold text-navy-black shadow">{categoryLabel}</span>}
  </div>
  <div class="flex flex-1 flex-col p-4 sm:p-5">
    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-gray">
      {published && <time datetime={isoDate(post.publishedAt)}>{published}</time>}
      {readingMinutes && <span>閱讀約 {readingMinutes} 分鐘</span>}
    </p>
    <Heading class="mt-2 text-base font-bold leading-snug text-ink sm:text-lg">
      <a href={href} class="after:absolute after:inset-0 hover:text-teal-strong">{post.title}</a>
    </Heading>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-gray">{post.excerpt}</p>
    {post.authorName && <p class="mt-3 text-xs text-slate-gray">{post.authorName}</p>}
  </div>
</article>

<style>
  [data-blog-card] {
    position: relative;
  }
</style>
