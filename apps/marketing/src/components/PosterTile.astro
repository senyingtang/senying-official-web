---
import type { PosterVisual } from '../content/types';

interface Props {
  poster: PosterVisual;
  class?: string;
}

/**
 * 海報式示意圖：以 HTML 文字與漸層繪製的版面方向，不是實際客戶作品。
 * 內容與卡片標題重複，因此對輔助科技隱藏。
 */
const { poster, class: className = '' } = Astro.props;
const themes: Record<PosterVisual['theme'], string> = {
  red: 'from-red-700 via-red-600 to-amber-500 text-amber-50',
  pink: 'from-rose-200 via-pink-100 to-rose-300 text-rose-900',
  teal: 'from-teal-700 via-cyan-700 to-sky-800 text-white',
  amber: 'from-stone-900 via-amber-900 to-orange-600 text-amber-50',
  blue: 'from-slate-900 via-blue-900 to-sky-700 text-white',
  green: 'from-emerald-100 via-lime-50 to-emerald-200 text-emerald-950',
  purple: 'from-indigo-950 via-violet-800 to-fuchsia-600 text-white',
  slate: 'from-slate-100 via-white to-slate-200 text-slate-800',
};
---

<div aria-hidden="true" class:list={['relative flex h-full w-full flex-col justify-between overflow-hidden bg-gradient-to-br px-4 pb-10 pt-3', themes[poster.theme], className]}>
  <span class="absolute -right-6 -top-6 h-24 w-24 rounded-full bg-white/15"></span>
  <span class="absolute -bottom-10 -left-8 h-28 w-28 rounded-full bg-black/10"></span>
  <span class="relative text-[10px] font-semibold uppercase tracking-[0.2em] opacity-80">示意版面</span>
  <span class="relative">
    <span class="block text-xl font-black leading-tight sm:text-2xl">{poster.headline}</span>
    <span class="mt-1 block text-xs font-medium opacity-85">{poster.sub}</span>
  </span>
</div>
