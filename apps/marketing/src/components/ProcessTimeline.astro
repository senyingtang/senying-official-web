---
import type { TimelineStep } from '../content/types';
import IconGlyph from './IconGlyph.astro';

interface Props {
  steps: TimelineStep[];
  tone?: 'light' | 'dark';
}

/**
 * 步驟時間軸：桌機（md 以上）橫向排列並以箭頭連接；手機直向排列，左側一條連接線。
 */
const { steps, tone = 'light' } = Astro.props;
const dark = tone === 'dark';
const columnClass = { 3: 'md:grid-cols-3', 4: 'md:grid-cols-4', 5: 'md:grid-cols-5', 6: 'md:grid-cols-6' }[steps.length] ?? 'md:grid-cols-5';
---

<ol data-process-timeline class:list={['grid gap-0 md:gap-4', columnClass]}>
  {
    steps.map((step, index) => {
      const last = index === steps.length - 1;
      return (
        <li class="relative flex min-w-0 gap-4 pb-6 last:pb-0 md:flex-col md:items-center md:pb-0 md:text-center">
          {!last && (
            <span
              aria-hidden="true"
              class:list={['absolute bottom-0 left-7 top-14 w-px md:hidden', dark ? 'bg-white/20' : 'bg-teal/30']}
            />
          )}
          {!last && (
            <span
              aria-hidden="true"
              class:list={[
                'absolute top-7 hidden h-px border-t border-dashed md:block',
                'left-[calc(50%+2.25rem)] right-[calc(-50%+2.25rem)]',
                dark ? 'border-white/30' : 'border-teal/40',
              ]}
            >
              <span class:list={['absolute -right-1 -top-[0.6rem] text-sm leading-none', dark ? 'text-teal' : 'text-teal-strong']}>›</span>
            </span>
          )}
          <span
            class:list={[
              'relative flex h-14 w-14 shrink-0 items-center justify-center rounded-full ring-8',
              dark ? 'bg-teal/15 text-teal ring-transparent' : 'bg-teal-soft text-teal-strong ring-mist-white',
            ]}
          >
            <IconGlyph name={step.icon} class="h-6 w-6" />
          </span>
          <div class="min-w-0 pt-1 md:pt-3">
            <h3 class:list={['text-base font-bold', dark ? 'text-white' : 'text-ink']}>
              <span class:list={['mr-1.5 font-mono', dark ? 'text-teal' : 'text-teal-strong']}>{index + 1}</span>
              {step.title}
            </h3>
            <p class:list={['mt-1 text-sm leading-relaxed', dark ? 'text-slate-300' : 'text-slate-gray']}>{step.description}</p>
          </div>
        </li>
      );
    })
  }
</ol>
