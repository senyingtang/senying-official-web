---
import type { MarketingSiteSettings, SocialPlatform } from '@syt/database/site-settings';
import type { IconName } from '../lib/icons';
import { floatingActionsView } from '../lib/site-settings';
import IconGlyph from './IconGlyph.astro';

interface Props {
  settings: MarketingSiteSettings;
}

const { settings } = Astro.props as Props;
const fa = settings.floatingActions;
const view = floatingActionsView(settings);
const brandEn = settings.brand.brandNameEn;

const icons: Record<SocialPlatform, IconName> = {
  line: 'message',
  facebook: 'facebook',
  instagram: 'instagram',
  threads: 'threads',
  youtube: 'youtube',
  tiktok: 'tiktok',
  email: 'mail',
  phone: 'phone',
};

const linkTarget = (openInNewTab: boolean, url: string) =>
  openInNewTab && /^https?:\/\//.test(url) ? { target: '_blank', rel: 'noopener noreferrer' } : {};

const badgeClass =
  'absolute flex h-5 min-w-5 items-center justify-center rounded-full bg-teal px-1 text-[11px] font-bold leading-none text-navy-black ring-2 ring-[#0b1f3b]';

/** rail 內每個項目的共用樣式：44×44 的 icon 按鈕（設計要求 40–46px） */
const railItemClass =
  'flex h-11 w-11 items-center justify-center rounded-xl text-slate-200 transition-colors hover:bg-teal/15 hover:text-teal focus-visible:bg-teal/15 focus-visible:text-teal focus-visible:outline-2 focus-visible:outline-teal';
const railDividerClass = 'mx-1.5 my-1 block h-px bg-white/15';

/**
 * 桌機 rail 顯示「全部」設定為 showOnDesktop 且網址有效的社群。
 * 高度由 icon-only 版面壓縮（每項 44px），不以截斷平台的方式縮短，
 * 因此這裡不做 slice —— 少顯示平台等於讓後台設定失效。
 */
const desktopSocials = view.desktopSocials;
---

{
  (view.desktop || view.mobile) && (
    <div
      data-floating-actions
      data-state={fa.defaultCollapsed ? 'collapsed' : 'expanded'}
      data-default-collapsed={String(fa.defaultCollapsed)}
      data-cart-enabled={String(fa.cartEnabled)}
      data-cart-badge-enabled={String(fa.cartBadgeEnabled)}
      data-brand-en={brandEn}
    >
      {view.desktop && (
        <div data-fa-desktop class="syt-z-floating fixed right-5 top-1/2 hidden -translate-y-1/2 lg:block">
          {/* 緊湊 icon rail：固定右側垂直置中，沒有 max-height / overflow scroll，不會出現內部捲軸 */}
          <div
            data-fa-expanded
            id="fa-rail"
            class="syt-fa-glass w-14 rounded-2xl border border-white/15 p-1.5 text-white shadow-xl shadow-black/25"
          >
            {desktopSocials.length > 0 && (
              <nav aria-label={`聯絡 ${brandEn}`}>
                <ul class="grid gap-1">
                  {desktopSocials.map((item) => (
                    <li>
                      <a
                        href={item.url}
                        data-social={item.platform}
                        title={item.label}
                        aria-label={item.label}
                        {...linkTarget(item.openInNewTab, item.url)}
                        class={railItemClass}
                      >
                        <IconGlyph name={icons[item.platform]} class="h-5 w-5" />
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}

            {fa.cartEnabled && (
              <>
                <span aria-hidden="true" class={railDividerClass} />
                <a
                  href={fa.cartHref}
                  data-cart-link
                  data-cart-label={fa.cartLabel}
                  title={fa.cartLabel}
                  aria-label={`${fa.cartLabel}，尚無商品`}
                  class:list={['relative', railItemClass]}
                >
                  <IconGlyph name="cart" class="h-5 w-5" />
                  <span data-cart-badge hidden class:list={[badgeClass, '-right-1 -top-1']} />
                </a>
              </>
            )}

            <span aria-hidden="true" class={railDividerClass} />

            <button
              type="button"
              data-fa-toggle
              aria-controls="fa-rail"
              aria-expanded="true"
              aria-label="收合快捷列"
              title="收合快捷列"
              class="flex h-9 w-11 items-center justify-center rounded-xl text-slate-300 transition-colors hover:bg-white/10 hover:text-white focus-visible:outline-2 focus-visible:outline-teal"
            >
              <IconGlyph name="chevron-right" class="h-4 w-4" />
            </button>
          </div>

          <button
            type="button"
            data-fa-compact
            data-fa-toggle
            aria-controls="fa-rail"
            aria-expanded="false"
            aria-label={`展開 ${brandEn} 快捷列`}
            class="syt-fa-glass relative flex h-14 w-14 items-center justify-center rounded-2xl border border-white/15 text-white shadow-xl shadow-black/25 transition-colors hover:border-teal/60 hover:text-teal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal"
          >
            <IconGlyph name="message" class="h-5 w-5" />
            {fa.cartEnabled && <span data-cart-badge hidden class:list={[badgeClass, '-right-1.5 -top-1.5']} />}
          </button>
        </div>
      )}

      {view.mobile && (
        <>
          <button
            type="button"
            data-fa-sheet-open
            aria-haspopup="dialog"
            aria-controls="fa-sheet"
            aria-expanded="false"
            aria-label={`聯絡 ${brandEn}`}
            class="syt-fa-glass syt-z-floating syt-fab-contact fixed right-4 flex h-14 w-14 items-center justify-center rounded-full border border-white/20 text-white shadow-xl shadow-black/30 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal lg:hidden"
          >
            <IconGlyph name="message" class="h-6 w-6" />
            {fa.cartEnabled && <span data-cart-badge hidden class:list={[badgeClass, '-right-1 -top-1']} />}
          </button>

          <div data-fa-sheet id="fa-sheet" hidden class="syt-z-sheet fixed inset-0 lg:hidden">
            {/*
              Backdrop 刻意「不是 button」：client 對所有 [data-fa-sheet-close] 綁定關閉，
              而驗收以 `[data-fa-sheet] button[data-fa-sheet-close]` 定位唯一的可見關閉鍵，
              若 backdrop 也是 button 會造成 Playwright strict mode 衝突。
            */}
            <div data-fa-sheet-close aria-hidden="true" class="absolute inset-0 bg-navy-black/60" />

            <div
              role="dialog"
              aria-modal="true"
              aria-labelledby="fa-sheet-title"
              class="syt-z-sheet-panel absolute inset-x-0 bottom-0 max-h-[85dvh] overflow-y-auto overscroll-contain rounded-t-3xl border-t border-white/10 bg-[#0b1f3b] px-4 pb-[calc(1rem+env(safe-area-inset-bottom))] pt-3 text-white shadow-2xl"
            >
              <span aria-hidden="true" class="mx-auto block h-1.5 w-10 rounded-full bg-white/25" />

              <p id="fa-sheet-title" class="mt-3 text-lg font-bold">
                聯絡 {brandEn}
              </p>

              {view.mobileSocials.length > 0 && (
                <ul class="mt-3 grid gap-2">
                  {view.mobileSocials.map((item) => (
                    <li>
                      <a
                        href={item.url}
                        data-social={item.platform}
                        {...linkTarget(item.openInNewTab, item.url)}
                        class="flex min-h-12 items-center gap-3 rounded-xl border border-white/10 bg-white/5 px-3 text-base text-slate-100 hover:border-teal/50 focus-visible:outline-2 focus-visible:outline-teal"
                      >
                        <IconGlyph name={icons[item.platform]} class="h-5 w-5 shrink-0 text-teal" />
                        <span class="min-w-0 flex-1 truncate">{item.label}</span>
                        <IconGlyph name="chevron-right" class="h-4 w-4 shrink-0 text-slate-400" />
                      </a>
                    </li>
                  ))}
                </ul>
              )}

              {fa.cartEnabled && (
                <a
                  href={fa.cartHref}
                  data-cart-link
                  data-cart-label={fa.cartLabel}
                  aria-label={`${fa.cartLabel}，尚無商品`}
                  class="mt-3 flex min-h-12 items-center gap-3 border-y border-white/10 px-3 py-2 text-base text-slate-100 focus-visible:outline-2 focus-visible:outline-teal"
                >
                  <span class="relative shrink-0">
                    <IconGlyph name="cart" class="h-5 w-5 text-teal" />
                    <span data-cart-badge hidden class:list={[badgeClass, '-right-3 -top-3']} />
                  </span>
                  <span class="min-w-0 flex-1">{fa.cartLabel}</span>
                  <span data-cart-count-text class="shrink-0 text-sm text-slate-300">
                    尚無商品
                  </span>
                </a>
              )}

              <button
                type="button"
                data-fa-sheet-close
                aria-label="關閉聯絡選單"
                class="mt-4 flex min-h-12 w-full items-center justify-center rounded-button border border-white/25 font-semibold text-white hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-teal"
              >
                關閉
              </button>
            </div>
          </div>
        </>
      )}
    </div>
  )
}

{
  view.desktop && (
    <script is:inline>
      (function () {
        try {
          const root = document.querySelector('[data-floating-actions]');
          const value = window.localStorage.getItem('syt-floating-actions-collapsed');
          if (root && (value === 'true' || value === 'false')) {
            root.setAttribute('data-state', value === 'true' ? 'collapsed' : 'expanded');
          }
        } catch {
          // localStorage unavailable: use configured default.
        }
      })();
    </script>
  )
}

<script>
  import { initFloatingActions } from '../lib/floating-actions-client';

  initFloatingActions();
</script>
