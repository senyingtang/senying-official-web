---
import type { IconFeature } from '../content/types';
import IconGlyph from './IconGlyph.astro';

interface Props {
  items: IconFeature[];
  columns?: 3 | 4 | 5 | 6;
  tone?: 'light' | 'dark';
  align?: 'center' | 'left';
  headingLevel?: 'h3' | 'h4';
}

/** 設計稿的密集功能卡：icon + 標題 + 兩行說明（+ 選用連結），手機兩欄 */
const { items, columns = 6, tone = 'light', align = 'center', headingLevel: Heading = 'h3' } = Astro.props;
const dark = tone === 'dark';
const columnClass = {
  3: 'grid-cols-1 xs:grid-cols-2 md:grid-cols-3',
  4: 'grid-cols-1 xs:grid-cols-2 lg:grid-cols-4',
  5: 'grid-cols-1 xs:grid-cols-2 md:grid-cols-3 lg:grid-cols-5',
  6: 'grid-cols-2 md:grid-cols-3 lg:grid-cols-6',
}[columns];
---

<ul class:list={['grid gap-3 sm:gap-4', columnClass]}>
  {
    items.map((item) => (
      <li
        class:list={[
          'syt-hover-glow flex min-w-0 flex-col rounded-2xl border p-4 transition-colors sm:p-5',
          align === 'center' ? 'items-center text-center' : 'items-start text-left',
          dark ? 'border-white/10 bg-white/5 hover:border-teal/40' : 'border-border-gray bg-surface shadow-card hover:border-teal/40',
        ]}
      >
        <span class:list={['flex h-12 w-12 shrink-0 items-center justify-center rounded-full', dark ? 'bg-teal/15 text-teal' : 'bg-teal-soft text-teal-strong']}>
          <IconGlyph name={item.icon} class="h-6 w-6" />
        </span>
        {item.tag && <span class="mt-3 rounded-full bg-teal/10 px-2 py-0.5 text-[11px] font-semibold text-teal-strong">{item.tag}</span>}
        <Heading class:list={['mt-3 text-base font-bold leading-snug', dark ? 'text-white' : 'text-ink']}>{item.title}</Heading>
        <p class:list={['mt-1.5 flex-1 text-sm leading-relaxed', dark ? 'text-slate-300' : 'text-slate-gray']}>{item.description}</p>
        {
          item.href && (
            <a
              href={item.href}
              class:list={[
                'mt-4 inline-flex min-h-10 items-center gap-1 rounded-button border px-3 text-sm font-semibold transition-colors',
                align === 'center' && 'self-center',
                dark ? 'border-teal/50 text-teal hover:bg-teal/10' : 'border-teal/60 text-teal-strong hover:bg-teal-soft',
              ]}
            >
              {item.linkLabel ?? '了解更多'}
              <span aria-hidden="true">→</span>
            </a>
          )
        }
      </li>
    ))
  }
</ul>
