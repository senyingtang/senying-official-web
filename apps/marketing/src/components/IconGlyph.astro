---
import { ICONS, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

/** 裝飾用 icon：一律 aria-hidden，意義由旁邊的文字提供 */
const { name, class: className = 'h-5 w-5', strokeWidth = 1.8 } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={ICONS[name]}
/>
