---
interface Props {
  /** dark：深色區塊的山稜線；light：淺色 CTA 的霧面山稜線 */
  tone?: 'dark' | 'light';
  class?: string;
}

/**
 * 山稜線背景：inline SVG（純色 + 透明度，不使用圖片或 CSS url()），不影響 LCP。
 * 放在 relative + overflow-hidden 的容器內，永遠在文字下層。
 */
const { tone = 'dark', class: className = '' } = Astro.props;
const fills =
  tone === 'dark'
    ? ['rgb(30 58 95 / 0.55)', 'rgb(15 40 70 / 0.75)', 'rgb(2 6 23 / 0.9)']
    : ['rgb(148 190 214 / 0.35)', 'rgb(94 146 178 / 0.35)', 'rgb(51 103 140 / 0.35)'];
---

<div aria-hidden="true" class:list={['pointer-events-none absolute inset-0 overflow-hidden', className]}>
  <svg class="absolute inset-x-0 bottom-0 h-32 w-full sm:h-44 lg:h-56" viewBox="0 0 1440 320" preserveAspectRatio="none" focusable="false">
    <path fill={fills[0]} d="M0 190 120 120l90 50 140-110 120 90 110-60 150 120 130-150 140 110 120-70 130 90 90-40v170H0Z"></path>
    <path fill={fills[1]} d="M0 240 150 170l110 60 160-120 140 110 120-60 170 110 150-90 130 70 150-80 160 90v160H0Z"></path>
    <path fill={fills[2]} d="M0 290 180 230l140 40 170-60 160 70 190-50 170 50 180-60 250 70v70H0Z"></path>
  </svg>
</div>
