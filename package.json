{
  "name": "syt-official-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:marketing": "pnpm --filter @syt/marketing dev",
    "dev:admin": "pnpm --filter @syt/admin dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "phase1:structure": "node scripts/phase1-structure-check.mjs",
    "db:verify-sync": "node scripts/verify-db-sql-sync.mjs",
    "rwd:serve": "node scripts/rwd-serve.mjs",
    "rwd:check": "node scripts/rwd-check.mjs",
    "rwd:check:with-server": "node scripts/rwd-check.mjs --rebuild",
    "phase1:verify": "node scripts/phase1-verify.mjs",
    "phase2:auth": "node scripts/phase2-auth-check.mjs",
    "phase2:verify": "node scripts/phase2-verify.mjs",
    "ui:verify": "node scripts/ui-ux-check.mjs",
    "mockup:verify": "node scripts/mockup-layout-check.mjs",
    "phase26b:verify": "pnpm mockup:verify && pnpm ui:verify && pnpm phase2:verify",
    "global-ui:verify": "node scripts/global-ui-check.mjs",
    "phase26c:verify": "pnpm global-ui:verify && pnpm mockup:verify && pnpm ui:verify && pnpm phase2:verify",
    "images:optimize": "node scripts/image-optimize.mjs",
    "images:report": "node scripts/image-report.mjs",
    "brand:generate": "node scripts/brand-assets.mjs",
    "og:generate": "node scripts/og-generate.mjs",
    "asset:verify": "node scripts/asset-optimization-check.mjs",
    "seo:verify": "node scripts/seo-check.mjs",
    "perf:verify": "node scripts/perf-check.mjs",
    "phase27:static": "pnpm asset:verify && pnpm seo:verify --skip-build && pnpm perf:verify --skip-build",
    "phase27:verify": "node scripts/phase27-verify.mjs",
    "supabase:start": "npx --no-install supabase start",
    "supabase:stop": "npx --no-install supabase stop",
    "supabase:status": "node scripts/with-local-supabase.mjs --status",
    "db:reset:local": "npx --no-install supabase db reset --local",
    "db:types": "node scripts/with-local-supabase.mjs --gen-types",
    "db:smoke": "node scripts/db-smoke-check.mjs",
    "site-settings:verify": "node scripts/site-settings-integration-check.mjs",
    "local-env:verify": "node scripts/local-env-security-check.mjs",
    "dev:admin:supabase": "node scripts/with-local-supabase.mjs pnpm --filter @syt/admin dev",
    "build:marketing:supabase": "node scripts/with-local-supabase.mjs pnpm --filter @syt/marketing build",
    "phase28:verify": "node scripts/phase28-verify.mjs"
  },
  "devDependencies": {
    "@syt/config": "workspace:*",
    "eslint": "9.39.5",
    "playwright-core": "1.63.0",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  }
}
