# =====================================================================
# 森映 Headless 自助建站電商平台 — 環境變數範本
# 複製成 apps/marketing/.env 與 apps/admin/.env.local 後填入「本機 / staging」值。
# 這個檔案只能保留空白值；不可提交任何正式 key、正式金流資料或正式網域。
# =====================================================================

# ---- 資料來源 --------------------------------------------------------
# DATA_SOURCE=mock（預設）
#   - 使用 packages/database 的 mock repository 與 mock 示範帳號（*@example.com），不連線任何 Supabase
#   - 不需要填任何 Supabase env
# DATA_SOURCE=supabase
#   - 必須同時設定 PUBLIC_SUPABASE_URL 與 PUBLIC_SUPABASE_ANON_KEY；
#     缺少時伺服器啟動（instrumentation）與登入頁會明確失敗，不會默默改用 mock
#   - 一般查詢一律使用「使用者 session」client（anon key + Auth cookie，RLS 生效）
#   - server action 若需要 admin 查詢，才允許使用 SUPABASE_SERVICE_ROLE_KEY，
#     而且只能在 server-only 檔案 apps/admin/src/lib/supabase/service-role.ts 讀取
#   - 只可接本機 supabase start 或 staging 專案；不可填正式專案 ref / 正式 key
# 其他值（例如打錯字）會直接報錯
DATA_SOURCE=mock

# ---- Supabase（PUBLIC_ 開頭會被打包到瀏覽器，只能放 anon key）--------------
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ 只允許伺服器端讀取（Next.js server-only 檔案 / Edge Function）。
# 不可加 PUBLIC_ / NEXT_PUBLIC_ 前綴，不可在 Astro 前台、proxy.ts 或 client component 使用。
SUPABASE_SERVICE_ROLE_KEY=

# ---- 登入（Phase 2）----------------------------------------------------
# DATA_SOURCE=mock 時 mock 登入 cookie 的 HMAC 簽章金鑰；空白時使用本機示範預設值。
# supabase 模式不使用（改用 Supabase Auth session）。
AUTH_COOKIE_SECRET=

# ---- 網址（不可硬寫正式網域，全部由環境變數提供）------------------------
# 例：本機 http://localhost:4321
SITE_PUBLIC_URL=
# 只有正式上線站才設為 true；未設定時 robots.txt 會禁止索引（避免 staging 被收錄）
SITE_ALLOW_INDEXING=
# 注意：SITE_ALLOW_INDEXING=true 時 SITE_PUBLIC_URL 必須是正式 https 網址（不可空白 / localhost），否則前台 build 會失敗
# 例：本機 http://localhost:3000
ADMIN_PUBLIC_URL=
# 客戶網站平台子網域根網域 / CNAME 目標（v2 起使用）
PLATFORM_SUBDOMAIN_ROOT=
# LINE 官方帳號加好友連結（客製報價 / 客服協助按鈕）
PUBLIC_LINE_OA_URL=

# ---- 金流（Phase 1 不串接；正式值只放 Supabase Vault / Edge Function Secrets）----
EC_PAY_MERCHANT_ID=
EC_PAY_HASH_KEY=
EC_PAY_HASH_IV=
LINE_PAY_CHANNEL_ID=
LINE_PAY_CHANNEL_SECRET=

# ---- 部署 / DNS（Phase 1 不使用）--------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
