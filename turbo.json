{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "PUBLIC_SUPABASE_URL",
        "PUBLIC_SUPABASE_ANON_KEY",
        "SITE_PUBLIC_URL",
        "ADMIN_PUBLIC_URL",
        "PLATFORM_SUBDOMAIN_ROOT",
        "PUBLIC_LINE_OA_URL",
        "DATA_SOURCE",
        "SITE_ALLOW_INDEXING",
        "SITE_SETTINGS_MOCK_PRESET"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
